# Copie para .streamlit/secrets.toml (rodar localmente) ou cole no painel
# "Secrets" do Streamlit Community Cloud. NUNCA faça commit do secrets.toml.

# Login (Supabase → Project Settings → API)
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."          # chave "anon public" (nunca a service_role)
CODIGO_CONVITE = "escolha-um-codigo"  # exigido para criar conta; apague a linha para cadastro livre

# APIs
GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = "..."
# GEMINI_MODEL = "gemini-flash-latest"  # opcional
